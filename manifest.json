{
  "manifest_version": 3,
  "name": "Merly TikTok Live Clip Downloader",
  "version": "0.2.0",
  "description": "Quet va tai hang loat clip live teaser va LIVE Highlights tu TikTok Shop.",
  "permissions": [
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://seller-vn.tiktok.com/*",
    "https://seller.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://*.akamaized.net/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller-vn.tiktok.com/*",
        "https://seller.tiktok.com/*",
        "https://shop.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://seller-vn.tiktok.com/*",
        "https://seller.tiktok.com/*",
        "https://shop.tiktok.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Merly TikTok Clips"
  }
}
